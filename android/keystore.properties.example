# Pegasus Suite — release signing template.
#
# Copy this file to android/keystore.properties and fill in real values, or
# generate both the keystore and this file automatically:
#
#     set KEYSTORE_PASSWORD=change-me
#     node scripts/generate-keystore.js
#
# NEVER commit android/keystore.properties or android/keystore/.

storeFile=keystore/release.keystore
storePassword=change-me
keyAlias=pegasusrelease
keyPassword=change-me
