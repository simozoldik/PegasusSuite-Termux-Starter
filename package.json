{
  "name": "pegasus-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Pegasus Suite — Android field-reconnaissance toolkit (RECON, CAMERAS, WIFI, CELL) built with Capacitor on top of a Node/Express LAN-audit backend.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/build-web.js",
    "cap:sync": "cap sync android",
    "cap:copy": "cap copy android",
    "cap:open": "cap open android",
    "cap:add:android": "cap add android",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "android:release": "cd android && gradlew.bat assembleRelease",
    "android:bundle": "cd android && gradlew.bat bundleRelease",
    "android:build:all": "cd android && gradlew.bat assembleDebug assembleRelease bundleRelease",
    "keystore:generate": "node scripts/generate-keystore.js",
    "test:web": "node scripts/check-web-build.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
