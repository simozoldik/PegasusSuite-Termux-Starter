# ============================================================
# Pegasus Suite — backend configuration (EXAMPLE)
# Copy to .env and adjust. The server also starts with zero
# configuration using the safe defaults shown below.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=8710
# 0.0.0.0 lets a phone on the same Wi-Fi reach the backend over the LAN.
HOST=0.0.0.0
# Set to true only when the backend sits behind a reverse proxy.
TRUST_PROXY=false
REQUIRE_HTTPS=false

# --- Bounded LAN scan defaults ---
# A single request can never expand into an unbounded sweep.
SCAN_DEFAULT_CIDR=192.168.1.0/24
SCAN_CONNECT_TIMEOUT_MS=800
SCAN_HTTP_TIMEOUT_MS=1500
SCAN_CONCURRENCY=64

# --- Rate limiting (API) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- CORS ---
# Extra origins for the native (Capacitor) WebView, on top of the built-in
# Capacitor defaults (https://localhost, capacitor://localhost). Add your PC's
# LAN address if you also load the web app directly from a browser.
CORS_ALLOWED_ORIGINS=http://192.168.1.137:8710
